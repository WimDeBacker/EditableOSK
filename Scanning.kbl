    <Key Row="0" Col="5" RowSpan="1" ColSpan="1" GroupId="standard" Label="woord 1" Send="wp:5" ShiftLabel="" ShiftSend="" AltGrLabel="" AltGrSend="" FontName="" FontSize="0" FontColor="" KeyColor="" BorderColor="" BorderThickness="-1" />
    <Key Row="0" Col="6" RowSpan="1" ColSpan="1" GroupId="standard" Label="woord 1" Send="wp:6" ShiftLabel="" ShiftSend="" AltGrLabel="" AltGrSend="" FontName="" FontSize="0" FontColor="" KeyColor="" BorderColor="" BorderThickness="-1" />
  </Layout>
