    <Key Row="0" Col="1" RowSpan="1" ColSpan="1" GroupId="standard" Label="woord 1" Send="wp:1" ShiftLabel="" ShiftSend="" AltGrLabel="" AltGrSend="" FontName="" FontSize="0" FontColor="" KeyColor="" BorderColor="" BorderThickness="-1" />
    <Key Row="0" Col="2" RowSpan="1" ColSpan="1" GroupId="standard" Label="woord 1" Send="wp:2" ShiftLabel="" ShiftSend="" AltGrLabel="" AltGrSend="" FontName="" FontSize="0" FontColor="" KeyColor="" BorderColor="" BorderThickness="-1" />
    <Key Row="0" Col="3" RowSpan="1" ColSpan="1" GroupId="standard" Label="woord 1" Send="wp:3" ShiftLabel="" ShiftSend="" AltGrLabel="" AltGrSend="" FontName="" FontSize="0" FontColor="" KeyColor="" BorderColor="" BorderThickness="-1" />
