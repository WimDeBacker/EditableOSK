<?xml version="1.0" encoding="utf-8"?>
<OnScreenKeyboard FormatVersion="2">
  <Info>
    <Title lang="nl">Wiskunde</Title>
    <Title lang="en">Mathematics</Title>
    <Description lang="nl">Toetsenbord voor wiskunde: cijfers, bewerkingen, vergelijkingen, haakjes, Griekse letters en andere symbolen.</Description>
    <Description lang="en">Keyboard for mathematics: numbers, operations, comparisons, brackets, Greek letters and other symbols.</Description>
    <Title lang="fr">Mathématiques</Title>
    <Title lang="it">Matematica</Title>
    <Title lang="es">Matemáticas</Title>
    <Description lang="fr">Clavier pour les mathématiques : chiffres, opérations, comparaisons, parenthèses, lettres grecques et autres symboles.</Description>
    <Description lang="it">Tastiera per la matematica: numeri, operazioni, confronti, parentesi, lettere greche e altri simboli.</Description>
    <Description lang="es">Teclado para matemáticas: números, operaciones, comparaciones, paréntesis, letras griegas y otros símbolos.</Description>
  </Info>
  <Theme BackgroundColor="1A1A2E" Opacity="1.00" FontName="Arial" FontSize="0" FontColor="E0E0FF" KeyColor="2D2D4A" BorderColor="3C3C5A" BorderThickness="1">
    <Group Id="standard" FontName="Arial" FontSize="0" FontColor="FFFFFF" KeyColor="2D2D4A" BorderColor="3C3C5A" BorderThickness="1" />
    <Group Id="arithmetic" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="4A3010" BorderColor="" BorderThickness="-1"><Name lang="nl">Rekenkunde</Name><Name lang="en">Arithmetic</Name><Name lang="fr">Arithmétique</Name><Name lang="it">Aritmetica</Name><Name lang="es">Aritmética</Name></Group>
    <Group Id="comparisons" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="2A3A10" BorderColor="" BorderThickness="-1"><Name lang="nl">Vergelijkingen</Name><Name lang="en">Comparisons</Name><Name lang="fr">Comparaisons</Name><Name lang="it">Confronti</Name><Name lang="es">Comparaciones</Name></Group>
    <Group Id="controls" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="3A1010" BorderColor="" BorderThickness="-1"><Name lang="nl">Besturing</Name><Name lang="en">Controls</Name><Name lang="fr">Commandes</Name><Name lang="it">Controlli</Name><Name lang="es">Control</Name></Group>
    <Group Id="brackets" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="103A3A" BorderColor="" BorderThickness="-1"><Name lang="nl">Haakjes</Name><Name lang="en">Brackets</Name><Name lang="fr">Parenthèses</Name><Name lang="it">Parentesi</Name><Name lang="es">Paréntesis</Name></Group>
    <Group Id="constants" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="3A2A00" BorderColor="" BorderThickness="-1"><Name lang="nl">Constanten</Name><Name lang="en">Constants</Name><Name lang="fr">Constantes</Name><Name lang="it">Costanti</Name><Name lang="es">Constantes</Name></Group>
    <Group Id="calculus" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="2A1040" BorderColor="" BorderThickness="-1"><Name lang="nl">Analyse</Name><Name lang="en">Calculus</Name><Name lang="fr">Analyse</Name><Name lang="it">Analisi</Name><Name lang="es">Cálculo</Name></Group>
    <Group Id="sets" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="3A1810" BorderColor="" BorderThickness="-1"><Name lang="nl">Verzamelingen</Name><Name lang="en">Sets</Name><Name lang="fr">Ensembles</Name><Name lang="it">Insiemi</Name><Name lang="es">Conjuntos</Name></Group>
    <Group Id="logic" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="3A1030" BorderColor="" BorderThickness="-1"><Name lang="nl">Logica</Name><Name lang="en">Logic</Name><Name lang="fr">Logique</Name><Name lang="it">Logica</Name><Name lang="es">Lógica</Name></Group>
    <Group Id="trigonometry" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="103060" BorderColor="" BorderThickness="-1"><Name lang="nl">Goniometrie</Name><Name lang="en">Trigonometry</Name><Name lang="fr">Trigonométrie</Name><Name lang="it">Trigonometria</Name><Name lang="es">Trigonometría</Name></Group>
    <Group Id="greek" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="103020" BorderColor="" BorderThickness="-1"><Name lang="nl">Grieks</Name><Name lang="en">Greek letters</Name><Name lang="fr">Lettres grecques</Name><Name lang="it">Lettere greche</Name><Name lang="es">Letras griegas</Name></Group>
    <Group Id="editing" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="1A2A1A" BorderColor="" BorderThickness="-1"><Name lang="nl">Bewerken</Name><Name lang="en">Editing</Name><Name lang="fr">Édition</Name><Name lang="it">Modifica</Name><Name lang="es">Edición</Name></Group>
    <Group Id="modifiers" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="251A35" BorderColor="" BorderThickness="-1"><Name lang="nl">Modifier</Name><Name lang="en">Modifier keys</Name><Name lang="fr">Touches de modification</Name><Name lang="it">Tasti modificatori</Name><Name lang="es">Teclas modificadoras</Name></Group>
    <Group Id="navigation" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="1A1A35" BorderColor="" BorderThickness="-1"><Name lang="nl">Navigatie</Name><Name lang="en">Navigation</Name><Name lang="fr">Navigation</Name><Name lang="it">Navigazione</Name><Name lang="es">Navegación</Name></Group>
    <Group Id="prediction" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="5B3080" BorderColor="00FF00" BorderThickness="1"><Name lang="nl">Woordvoorspelling</Name><Name lang="en">Word prediction</Name><Name lang="fr">Prédiction de mots</Name><Name lang="it">Previsione delle parole</Name><Name lang="es">Predicción de palabras</Name></Group>
    <Group Id="numbers" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="008040" BorderColor="00FF00" BorderThickness="1"><Name lang="nl">Cijfers</Name><Name lang="en">Numbers</Name><Name lang="fr">Chiffres</Name><Name lang="it">Numeri</Name><Name lang="es">Números</Name></Group>
    <Group Id="vowels" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="4A8FD4" BorderColor="00FF00" BorderThickness="1"><Name lang="nl">Klinkers</Name><Name lang="en">Vowels</Name><Name lang="fr">Voyelles</Name><Name lang="it">Vocali</Name><Name lang="es">Vocales</Name></Group>
    <Group Id="consonants" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="1A4E8A" BorderColor="00FF00" BorderThickness="1"><Name lang="nl">Medeklinkers</Name><Name lang="en">Consonants</Name><Name lang="fr">Consonnes</Name><Name lang="it">Consonanti</Name><Name lang="es">Consonantes</Name></Group>
    <Group Id="punctuation" FontName="" FontSize="0" FontColor="FFFFFF" KeyColor="C86A00" BorderColor="00FF00" BorderThickness="1"><Name lang="nl">Leestekens</Name><Name lang="en">Punctuation</Name><Name lang="fr">Ponctuation</Name><Name lang="it">Punteggiatura</Name><Name lang="es">Puntuación</Name></Group>
  </Theme>
  <Layout Language="nl" GridRows="7" GridCols="22" GearRow="0" GearCol="-1" WindowWidth="1057" WindowHeight="342" HideTitlebar="0" StickyModifiers="0" HoldToEdit="0" AlwaysOnTop="1" SlowKeysMs="0" DwellMs="0" ShowTimingAnimation="1" LastFile="" ToolbarTheme="Dark" WordLearningEnabled="1">
